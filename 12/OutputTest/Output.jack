    /** Creates the character map array for the given character index */
    function void create(int index, int a, int b, int c, int d, int e,
                         int f, int g, int h, int i, int j, int k) {
        var Array map;
        let map = Array.new(11);
        let charMaps[index] = map;
        let map[0] = a;
        let map[1] = b;
        let map[2] = c;
        let map[3] = d;
        let map[4] = e;
        let map[5] = f;
        let map[6] = g;
        let map[7] = h;
        let map[8] = i;
        let map[9] = j;
        let map[10] = k;
        return;
    }

    /** Creates pre-shifted character maps for odd columns */
    function void createShiftedMap() {
        var int i, j;
        var Array normalMap, shiftedMap;
        
        let shiftedMaps = Array.new(127);
        let i = 0;
        
        while (i < 127) {
            let normalMap = charMaps[i];
            let shiftedMap = Array.new(11);
            let shiftedMaps[i] = shiftedMap;
            
            let j = 0;
            while (j < 11) {
                let shiftedMap[j] = normalMap[j] * 256;
                let j = j + 1;
            }
            
            if (i = 0) {
                let i = 32;
            } else {
                let i = i + 1;
            }
        }
        return;
    }

    /** Gets the appropriate character map based on column position */
    function Array getMap(char c) {
        var Array map;
        
        if (c < 32) {
            let c = 0;
        }
        if (c > 126) {
            let c = 0;
        }
        
        if (isOddCol) {
            let map = shiftedMaps[c];
        } else {
            let map = charMaps[c];
        }
        
        return map;
    }

    /** Character drawing function */
    function void drawChar(char c) {
        var Array map;
        var int addr, i, existingBits, screenAddr;
        
        let map = Output.getMap(c);
        let addr = cursorAddress;
        let i = 0;
        
        while (i < 11) {
            let screenAddr = screenBase + addr;
            
            if (screenAddr < 16384) {
                return;
            }
            if (screenAddr > 24575) {
                return;
            }
            
            if (isOddCol) {
                let existingBits = Memory.peek(screenAddr) & 255;
            } else {
                let existingBits = Memory.peek(screenAddr) & (-256);
            }
            
            do Memory.poke(screenAddr, map[i] | existingBits);
            let addr = addr + 32;
            let i = i + 1;
        }
        return;
    }

    /** Moves the cursor to the j-th column of the i-th row */
    function void moveCursor(int i, int j) {
        var int temp, rowOffset;
        
        if (i < 0) {
            do Sys.error(20);
        }
        if (i > 22) {
            do Sys.error(20);
        }
        if (j < 0) {
            do Sys.error(20);
        }
        if (j > 63) {
            do Sys.error(20);
        }
        
        let cursorCol = j / 2;
        
        let rowOffset = i * 32;
        let rowOffset = rowOffset * 11;
        let cursorAddress = rowOffset + cursorCol;
        
        let temp = cursorCol * 2;
        if (j = temp) {
            let isOddCol = false;
        } else {
            let isOddCol = true;
        }
        
        do Output.drawChar(32);
        return;
    }

    /** Displays the given character at the cursor location */
    function void printChar(char c) {
        if (c = String.newLine()) {
            do Output.println();
            return;
        }
        
        if (c = String.backSpace()) {
            do Output.backSpace();
            return;
        }
        
        do Output.drawChar(c);
        
        if (isOddCol) {
            let cursorCol = cursorCol + 1;
            let cursorAddress = cursorAddress + 1;
            let isOddCol = false;
        } else {
            let isOddCol = true;
        }
        
        if (cursorCol = 32) {
            do Output.println();
        }
        return;
    }

    /** Displays the given string starting at the cursor location */
    function void printString(String s) {
        var int i, len;
        let len = s.length();
        let i = 0;
        while (i < len) {
            do Output.printChar(s.charAt(i));
            let i = i + 1;
        }
        return;
    }

    /** Displays the given integer starting at the cursor location */
    function void printInt(int i) {
        do intBuffer.setInt(i);
        do Output.printString(intBuffer);
        return;
    }

    /** Advances the cursor to the beginning of the next line */
    function void println() {
        var int offset;
        let offset = 352 - cursorCol;
        let cursorAddress = cursorAddress + offset;
        let cursorCol = 0;
        let isOddCol = false;
        
        if (cursorAddress > 7743) {
            let cursorAddress = 0;
        }
        return;
    }

    /** Moves the cursor one column back */
    function void backSpace() {
        if (isOddCol) {
            let isOddCol = false;
        } else {
            if (cursorCol > 0) {
                let cursorCol = cursorCol - 1;
                let cursorAddress = cursorAddress - 1;
                let isOddCol = true;
            } else {
                let cursorCol = 31;
                let isOddCol = true;
                if (cursorAddress = 0) {
                    let cursorAddress = 7775;
                } else {
                    let cursorAddress = cursorAddress - 321;
                }
            }
        }
        
        do Output.drawChar(32);
        return;
    }
}