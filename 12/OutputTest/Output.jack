/**
 * A library of functions for writing text on the screen.
 * Jack-compliant implementation.
 */
class Output {
    static int cursorCol;      // static 0 - Current cursor column (0-31 word positions)
    static int cursorAddress;  // static 1 - Current cursor memory address  
    static boolean isOddCol;   // static 2 - true if odd column (right half of word)
    static String intBuffer;   // static 3 - Reusable string buffer for integers
    static int screenBase;     // static 4 - Screen memory base address
    static Array charMaps;     // static 5 - Normal character maps
    static Array shiftedMaps;  // static 6 - Pre-shifted character maps for odd columns

    /** Initializes the screen, and locates the cursor at the screen's top-left. */
    function void init() {
        let screenBase = 16384;
        let isOddCol = false;
        let cursorAddress = 0;
        let cursorCol = 0;
        let intBuffer = String.new(6);
        
        do Output.initMap();
        do Output.createShiftedMap();
        return;
    }

